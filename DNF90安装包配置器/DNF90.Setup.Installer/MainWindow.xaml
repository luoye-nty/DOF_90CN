<Window x:Class="DNF90.Setup.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="落叶DNF 安装程序"
        Width="760"
        Height="610"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#050B12"
        Foreground="#EAF8FF">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#07111D" Offset="0" />
                <GradientStop Color="#0A1D2D" Offset="0.55" />
                <GradientStop Color="#061018" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border BorderBrush="#355C73" BorderThickness="1" CornerRadius="8" Margin="12">
            <Grid Margin="28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock x:Name="ProductNameText"
                                   Text="落叶DNF"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#DDF7FF" />
                        <TextBlock x:Name="VersionText"
                                   Text="安装程序"
                                   Margin="0,5,0,0"
                                   FontSize="13"
                                   Foreground="#7ECDEB" />
                    </StackPanel>
                    <TextBlock Text="CLIENT INSTALLER"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               FontSize="11"
                               Foreground="#527B92"
                               FontWeight="SemiBold" />
                </Grid>

                <Border Grid.Row="1" Margin="0,22,0,16" BorderBrush="#284B61" BorderThickness="0,1,0,0" />

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="安装位置" Foreground="#A7CDDE" FontSize="12" />
                    <Grid Grid.Row="1" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InstallPathTextBox" VerticalContentAlignment="Center" />
                        <Button x:Name="BrowsePathButton"
                                Grid.Column="1"
                                Content="选择文件夹…"
                                Margin="10,0,0,0"
                                IsEnabled="False"
                                Click="BrowseButton_Click" />
                    </Grid>
                    <TextBlock Grid.Row="2"
                               Text="如果选择的是磁盘根目录，将自动安装到该磁盘的“地下城与勇士”文件夹。"
                               Margin="0,7,0,0"
                               Foreground="#668FA2"
                               FontSize="11"
                               TextWrapping="Wrap" />

                    <TextBlock x:Name="SummaryText"
                               Grid.Row="3"
                               Margin="0,10,0,8"
                               Foreground="#8AB4C6"
                               FontSize="12"
                               Text="正在读取安装包…" />

                    <ListBox x:Name="PackageList"
                             Grid.Row="4"
                             Background="#08131E"
                             BorderBrush="#244354"
                             Foreground="#D9F0FA"
                             Padding="8"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayName}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Detail}"
                                               Foreground="#6F9DB2"
                                               Margin="18,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <CheckBox x:Name="ShortcutCheckBox" Content="创建桌面快捷方式" IsChecked="True" />
                        <CheckBox x:Name="LaunchCheckBox" Content="安装完成后启动登录器" IsChecked="True" />
                    </StackPanel>
                    <ProgressBar x:Name="InstallProgress"
                                 Grid.Row="1"
                                 Height="10"
                                 Margin="0,12,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Foreground="#37C9F2"
                                 Background="#0B1B27"
                                 BorderBrush="#31556B" />
                    <Grid Grid.Row="2" Margin="0,9,0,0">
                        <TextBlock x:Name="StatusText" Text="准备安装" Foreground="#D7F4FF" />
                        <TextBlock x:Name="DetailText"
                                   Text=""
                                   HorizontalAlignment="Right"
                                   Foreground="#6F9DB2"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="430" />
                    </Grid>
                </Grid>

                <Grid Grid.Row="4" Margin="0,20,0,0">
                    <Button x:Name="CloseButton"
                            Content="关闭"
                            HorizontalAlignment="Left"
                            Width="88"
                            Click="CloseButton_Click" />
                    <Button x:Name="InstallButton"
                            Content="开始安装"
                            HorizontalAlignment="Right"
                            Width="130"
                            Background="#08658D"
                            BorderBrush="#69E1FF"
                            FontWeight="SemiBold"
                            IsEnabled="False"
                            Click="InstallButton_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
