<Window x:Class="DNF90.Setup.Builder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="落叶DNF 安装包配置器"
        Width="820"
        Height="900"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#050B12"
        Foreground="#EAF8FF">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#07111D" Offset="0" />
                <GradientStop Color="#0A1D2D" Offset="0.55" />
                <GradientStop Color="#061018" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border BorderBrush="#355C73" BorderThickness="1" CornerRadius="8" Margin="12">
            <Grid Margin="28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel>
                        <TextBlock Text="落叶DNF 安装包配置器" FontSize="26" FontWeight="Bold" Foreground="#DDF7FF" />
                        <TextBlock Text="选择游戏客户端目录，生成可独立运行的安装程序。"
                                   Margin="0,5,0,0"
                                   Foreground="#78BBD4"
                                   FontSize="12" />
                    </StackPanel>
                    <TextBlock Text="PACKAGE BUILDER"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Foreground="#527B92"
                               FontWeight="SemiBold"
                               FontSize="11" />
                </Grid>

                <Border Margin="0,20,0,16" BorderBrush="#284B61" BorderThickness="0,1,0,0" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                    <StackPanel>
                        <TextBlock Text="1. 游戏客户端目录" Foreground="#A7CDDE" FontSize="12" />
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ClientPathTextBox" IsReadOnly="True" />
                            <Button Grid.Column="1" Content="选择文件夹…" Margin="10,0,0,0" Click="SelectClientButton_Click" />
                        </Grid>
                        <TextBlock x:Name="ClientSummaryText"
                                   Text="尚未选择客户端目录"
                                   Margin="0,8,0,0"
                                   Foreground="#78A9BC"
                                   FontSize="12"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="登录器文件" Margin="0,14,0,0" Foreground="#A7CDDE" FontSize="12" />
                        <ComboBox x:Name="LauncherComboBox"
                                  Margin="0,7,0,0"
                                  Height="34"
                                  Padding="8,4"
                                  Background="#0E1823"
                                  Foreground="#E7F5FF"
                                  BorderBrush="#345A72"
                                  MaxDropDownHeight="260"
                                  SelectedValuePath="FullPath"
                                  TextSearch.TextPath="FileName"
                                  SelectionChanged="LauncherComboBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FileName}"
                                               Foreground="#E7F5FF"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="#0E1823" />
                                    <Setter Property="Foreground" Value="#E7F5FF" />
                                    <Setter Property="Padding" Value="9,6" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBoxItem">
                                                <Border x:Name="ItemBorder"
                                                        Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#1C3C56" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#24536F" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBox.Template>
                                <ControlTemplate TargetType="ComboBox">
                                    <Grid>
                                        <ToggleButton x:Name="ToggleButton"
                                                      Focusable="False"
                                                      ClickMode="Press"
                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="ComboBorder"
                                                            Background="#0E1823"
                                                            BorderBrush="#345A72"
                                                            BorderThickness="1"
                                                            CornerRadius="4">
                                                        <Grid>
                                                            <ContentPresenter Margin="10,0,34,0"
                                                                              VerticalAlignment="Center"
                                                                              HorizontalAlignment="Left"
                                                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                                              ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                                              TextElement.Foreground="#E7F5FF" />
                                                            <Path Data="M 0,0 L 5,5 L 10,0"
                                                                  Stroke="#9ED9F0"
                                                                  StrokeThickness="1.5"
                                                                  HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,12,0" />
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#69DAFF" />
                                                            <Setter TargetName="ComboBorder" Property="Background" Value="#122333" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>

                                        <TextBlock x:Name="EmptyText"
                                                   Text="未找到可选登录器"
                                                   Margin="10,0,34,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#7FA5B7"
                                                   IsHitTestVisible="False"
                                                   Visibility="Collapsed" />

                                        <Popup x:Name="PART_Popup"
                                               Placement="Bottom"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade"
                                               IsOpen="{TemplateBinding IsDropDownOpen}">
                                            <Border Background="#0E1823"
                                                    BorderBrush="#416B84"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Margin="0,3,0,0"
                                                    MinWidth="{TemplateBinding ActualWidth}"
                                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="HasItems" Value="False">
                                            <Setter TargetName="EmptyText" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ComboBox.Template>
                        </ComboBox>
                        <TextBlock Text="从客户端根目录的 EXE 中选择登录器；会自动优先选择名称包含“登录器”的文件。"
                                   Margin="0,5,0,0"
                                   Foreground="#668FA2"
                                   FontSize="11"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="2. 输出与版本" Margin="0,20,0,0" Foreground="#A7CDDE" FontSize="12" />
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputPathTextBox" IsReadOnly="True" />
                            <Button Grid.Column="1" Content="选择输出目录…" Margin="10,0,0,0" Click="SelectOutputButton_Click" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="版本号" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#9DC9DA" />
                            <TextBox x:Name="VersionTextBox" Grid.Column="1" Text="1.0.1" TextChanged="PackageNameInput_TextChanged" />
                            <TextBlock Text="ImagePacks2 每个分包目标" Grid.Column="2" VerticalAlignment="Center" Margin="20,0,10,0" Foreground="#9DC9DA" />
                            <TextBox x:Name="SplitSizeTextBox" Grid.Column="3" Text="4096" />
                            <TextBlock Text="MB" Grid.Column="4" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#6F9DB2" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="安装器名称" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#9DC9DA" />
                            <TextBox x:Name="SetupNameTextBox" Grid.Column="1" Text="Setup" />
                            <TextBlock Text="分卷前缀" Grid.Column="2" VerticalAlignment="Center" Margin="20,0,10,0" Foreground="#9DC9DA" />
                            <TextBox x:Name="PackagePrefixTextBox" Grid.Column="3" Text="DNF_LY" TextChanged="PackageNameInput_TextChanged" />
                            <TextBlock x:Name="PackageNameExampleText"
                                       Grid.Column="4"
                                       Text="示例：DNF_LY_1.0.1_001.zip"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       Foreground="#6F9DB2"
                                       FontSize="11" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="默认安装文件夹"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"
                                       Foreground="#9DC9DA" />
                            <TextBox x:Name="InstallFolderNameTextBox"
                                     Grid.Column="1"
                                     Text="地下城与勇士" />
                        </Grid>
                        <TextBlock Text="安装器默认使用 D:\该文件夹名；若最终选择的是任意磁盘根目录，也会自动创建并使用这个文件夹名。"
                                   Margin="24,5,0,0"
                                   Foreground="#668FA2"
                                   FontSize="11"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="3. 发布内容" Margin="0,20,0,0" Foreground="#A7CDDE" FontSize="12" />
                        <WrapPanel Margin="0,7,0,0">
                            <RadioButton x:Name="FullReleaseRadio"
                                         GroupName="ReleaseContent"
                                         Content="全量发布"
                                         IsChecked="True"
                                         Checked="ReleaseContent_Changed" />
                            <RadioButton x:Name="PvfReleaseRadio"
                                         GroupName="ReleaseContent"
                                         Content="PVF 发布"
                                         Checked="ReleaseContent_Changed" />
                            <RadioButton x:Name="NpkReleaseRadio"
                                         GroupName="ReleaseContent"
                                         Content="NPK 发布"
                                         Checked="ReleaseContent_Changed" />
                            <RadioButton x:Name="AccessoryReleaseRadio"
                                         GroupName="ReleaseContent"
                                         Content="登录器配件发布"
                                         Checked="ReleaseContent_Changed" />
                        </WrapPanel>
                        <TextBlock Text="PVF 固定为 001；登录器配件固定为 002；ImagePacks2 从 003 开始。单项发布会覆盖同名 .zip，其他分卷保持不变。"
                                   Margin="24,4,0,0"
                                   Foreground="#668FA2"
                                   FontSize="11"
                                   TextWrapping="Wrap" />

                        <Border Margin="0,18,0,0" Padding="12" Background="#08131E" BorderBrush="#244354" BorderThickness="1" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="压缩策略" Foreground="#A7CDDE" FontSize="12" />
                                <TextBlock Text="登录器、90CN.dll（存在时）和其他剩余文件合并为一个分区；Script.pvf 独立；ImagePacks2 按目标大小分成多个 ZIP 分卷。所有文件统一使用 ZIP Fastest 真实压缩，并并行处理多个分卷；安装时只覆盖同名文件，不会主动删除目标目录内其他文件。"
                                           Margin="0,6,0,0"
                                           Foreground="#6F9DB2"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="3" Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ProgressBar x:Name="BuildProgress"
                                 Height="10"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Foreground="#37C9F2"
                                 Background="#0B1B27"
                                 BorderBrush="#31556B" />
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock x:Name="StatusText" Text="等待选择客户端目录" Foreground="#D7F4FF" />
                        <TextBlock x:Name="DetailText"
                                   HorizontalAlignment="Right"
                                   Foreground="#6F9DB2"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="470" />
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Button x:Name="OpenOutputButton"
                                Content="打开输出目录"
                                Width="118"
                                HorizontalAlignment="Left"
                                IsEnabled="False"
                                Click="OpenOutputButton_Click" />
                        <Button x:Name="BuildButton"
                                Content="生成安装程序"
                                Width="150"
                                HorizontalAlignment="Right"
                                Background="#08658D"
                                BorderBrush="#69E1FF"
                                FontWeight="SemiBold"
                                IsEnabled="False"
                                Click="BuildButton_Click" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
