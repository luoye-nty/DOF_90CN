<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DNF90.Setup.Builder</RootNamespace>
    <AssemblyName>落叶DNF安装包配置器</AssemblyName>
    <ApplicationIcon>..\..\登录器\Assets\DNF.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DNF90.Setup.Shared\DNF90.Setup.Shared.csproj" />
    <Resource Include="..\..\登录器\Assets\DNF.ico" Link="Assets\DNF.ico" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-InstallerSuite.ps1 会先把独立安装器发布到这里，再发布配置器。 -->
    <EmbeddedResource Include="RuntimeAssets\*.exe">
      <LogicalName>DNF90.Setup.Builder.Runtime.Installer.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
