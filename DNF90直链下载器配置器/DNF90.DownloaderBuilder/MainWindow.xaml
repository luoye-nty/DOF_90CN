<Window x:Class="DNF90.DownloaderBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNF直链下载器配置器"
        Width="820"
        Height="730"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#050B12"
        Foreground="#EAF8FF">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#07111D" Offset="0" />
                <GradientStop Color="#0A1D2D" Offset="0.55" />
                <GradientStop Color="#061018" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border BorderBrush="#355C73" BorderThickness="1" CornerRadius="8" Margin="12">
            <Grid Margin="28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel>
                        <TextBlock Text="DNF直链下载器配置器"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#DDF7FF" />
                        <TextBlock Text="配置多个直链地址并生成独立的单文件下载器。"
                                   Margin="0,5,0,0"
                                   Foreground="#78BBD4"
                                   FontSize="12" />
                    </StackPanel>
                    <TextBlock Text="DOWNLOADER BUILDER"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Foreground="#527B92"
                               FontWeight="SemiBold"
                               FontSize="11" />
                </Grid>

                <Border Grid.Row="1" Margin="0,20,0,16" BorderBrush="#284B61" BorderThickness="0,1,0,0" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                    <StackPanel>
                        <TextBlock Text="1. 下载器名称" Foreground="#A7CDDE" FontSize="12" />
                        <TextBox x:Name="DownloaderNameTextBox"
                                 Margin="0,7,0,0"
                                 Text="DNF直链下载器" />

                        <TextBlock Text="2. 直链地址（一行一个，按顺序下载）"
                                   Margin="0,18,0,0"
                                   Foreground="#A7CDDE"
                                   FontSize="12" />
                        <TextBox x:Name="UrlsTextBox"
                                 Margin="0,7,0,0"
                                 Height="125"
                                 AcceptsReturn="True"
                                 AcceptsTab="False"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" />

                        <TextBlock Text="3. 默认下载位置" Margin="0,18,0,0" Foreground="#A7CDDE" FontSize="12" />
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="磁盘" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#9DC9DA" />
                            <TextBox x:Name="DiskTextBox" Grid.Column="1" Text="D" MaxLength="2" />
                            <TextBlock Text=":\" Grid.Column="2" VerticalAlignment="Center" Margin="7,0,10,0" Foreground="#9DC9DA" />
                            <TextBox x:Name="FolderNameTextBox" Grid.Column="3" Text="地下城与勇士安装文件" />
                        </Grid>
                        <TextBlock Text="下载器默认保存到“配置磁盘:\配置文件夹名”；用户也可以在选择根目录时自动使用该文件夹名。"
                                   Margin="24,5,0,0"
                                   Foreground="#668FA2"
                                   FontSize="11"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="4. 输出目录" Margin="0,18,0,0" Foreground="#A7CDDE" FontSize="12" />
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputPathTextBox" IsReadOnly="True" />
                            <Button Grid.Column="1"
                                    Content="选择输出目录…"
                                    Margin="10,0,0,0"
                                    Click="SelectOutputButton_Click" />
                        </Grid>

                        <Border Margin="0,18,0,0"
                                Padding="12"
                                Background="#08131E"
                                BorderBrush="#244354"
                                BorderThickness="1"
                                CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="下载器行为" Foreground="#A7CDDE" FontSize="12" />
                                <TextBlock Text="所有地址严格按顺序下载；下载器内提供“下载完打开安装”。如果直接下载到唯一 EXE，会启动后关闭下载器；如果下载内容没有 EXE，会提示手动解压且保持下载器打开。"
                                           Margin="0,6,0,0"
                                           Foreground="#6F9DB2"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="3" Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock x:Name="StatusText" Text="填写配置后生成下载器" Foreground="#D7F4FF" />
                        <TextBlock x:Name="DetailText"
                                   HorizontalAlignment="Right"
                                   Foreground="#6F9DB2"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="500" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Button x:Name="OpenOutputButton"
                                Content="打开输出目录"
                                Width="118"
                                HorizontalAlignment="Left"
                                IsEnabled="False"
                                Click="OpenOutputButton_Click" />
                        <Button x:Name="GenerateButton"
                                Content="生成直链下载器"
                                Width="160"
                                HorizontalAlignment="Right"
                                Background="#08658D"
                                BorderBrush="#69E1FF"
                                FontWeight="SemiBold"
                                Click="GenerateButton_Click" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
