<Window x:Class="DNF90.DirectDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNF直链下载器"
        Width="760"
        Height="570"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#050B12"
        Foreground="#EAF8FF">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#07111D" Offset="0" />
                <GradientStop Color="#0A1D2D" Offset="0.55" />
                <GradientStop Color="#061018" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border BorderBrush="#355C73" BorderThickness="1" CornerRadius="8" Margin="12">
            <Grid Margin="28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="DownloaderNameText"
                                   Text="DNF直链下载器"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="#DDF7FF" />
                    </StackPanel>
                    <TextBlock Text="DIRECT DOWNLOADER"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               FontSize="11"
                               Foreground="#527B92"
                               FontWeight="SemiBold" />
                </Grid>

                <Border Grid.Row="1" Margin="0,20,0,16" BorderBrush="#284B61" BorderThickness="0,1,0,0" />

                <StackPanel Grid.Row="2">
                    <TextBlock Text="下载位置" Foreground="#A7CDDE" FontSize="12" />
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DownloadPathTextBox" VerticalContentAlignment="Center" />
                        <Button x:Name="BrowseButton"
                                Grid.Column="1"
                                Content="选择文件夹…"
                                Margin="10,0,0,0"
                                Click="BrowseButton_Click" />
                    </Grid>
                    <TextBlock Text="若选择磁盘根目录，会自动使用配置的默认下载文件夹名称。"
                               Margin="0,7,0,0"
                               Foreground="#668FA2"
                               FontSize="11" />

                    <CheckBox x:Name="OpenInstallerCheckBox"
                              Content="下载完打开安装"
                              IsChecked="True"
                              Margin="0,18,0,0" />
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ProgressBar x:Name="DownloadProgress"
                                 Height="10"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Foreground="#37C9F2"
                                 Background="#0B1B27"
                                 BorderBrush="#31556B" />
                    <Grid Grid.Row="1" Margin="0,9,0,0">
                        <TextBlock x:Name="StatusText" Text="准备就绪" Foreground="#D7F4FF" />
                        <TextBlock x:Name="DetailText"
                                   HorizontalAlignment="Right"
                                   Foreground="#6F9DB2"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="430" />
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Button x:Name="LeftButton"
                                Content="关闭"
                                Width="110"
                                HorizontalAlignment="Left"
                                Click="LeftButton_Click" />
                        <Button x:Name="StartButton"
                                Content="开始下载"
                                Width="140"
                                HorizontalAlignment="Right"
                                Background="#08658D"
                                BorderBrush="#69E1FF"
                                FontWeight="SemiBold"
                                Click="StartButton_Click" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
