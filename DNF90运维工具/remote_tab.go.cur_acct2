				},
				GroupBox{
					Title:  "配对码管理",
					Layout: VBox{Margins: Margins{10, 8, 10, 8}, Spacing: 8},
					Children: []Widget{
						Composite{
							Layout: HBox{MarginsZero: true, Spacing: 8},
