# ============================================================
#  DNF90 服务端 · 安装配置（安装前只需要改这个文件）
#  改完保存，然后在 Ubuntu 上运行：  sudo bash install.sh
# ============================================================

# 【必填】服务器公网 IP。
#   云服务器：控制台里"公网IP / 弹性IP"那一串，比如 123.45.67.89
#   家里电脑做服务器：填宽带公网 IP（需要在路由器做端口映射），或先用内网 IP 测试
PUBLIC_IP=

# 【建议改】MySQL 数据库密码。
#   随便设一个，只允许用 字母 和 数字（不要用特殊符号，避免转义问题）。
#   安装脚本会自动用这个密码创建数据库账号 dnf90。留空则自动随机生成。
MYSQL_PASSWORD=

# 注册方式（二选一）：
#   invite = 邀请码注册，一人一码（玩家必须填对邀请码才能注册）
#            · 首次启动时认证服务会自动生成一个「引导邀请码」并写进 logs/dnf90auth.log，
#              表中也会留一份（launcher_invites），用它当入口；
#            · 批量发码用 gen_invite_codes.sql（改开头的数量后执行即可）；
#            · 这个模式下 ALLOW_REGISTRATION 不生效。
#   open   = 玩家在登录器里自助注册，是否开放由下面的 ALLOW_REGISTRATION 决定。
REGISTRATION_MODE=invite

# 【仅 open 模式生效】允许玩家自助注册（true=玩家可在登录器里自己注册账号；false=只能管理员建号）
ALLOW_REGISTRATION=true

# 单个 IP 最多允许注册几个账号。
#   留空 或 填 0  = 不限制
#   填 1~1000     = 每个 IP 最多注册这么多
MAX_REGISTER_PER_IP=

# 在线活动「累计 25 次」的累计进度是否循环：
#   on  = 四个累计档全部领完之后，第二天（06:00 换天）从 0 次重新累计（默认）
#         每个账号按自己的进度独立重置
#   off = 保持封顶，领满 25 次即永久结束
# 已安装的服务器可直接改 /opt/dnf90/conf/server.env 里的这行，再 systemctl restart dnf90server
PCROOM_PERIOD_LOOP=on

# 服务器显示的"区服名"（客户端里可能不显示，先留着）
REGION_NAME=

# ================= 网页管理后台 =================
# 后台登录密码。留空则自动随机生成（安装完会打印出来）。
# ⚠ 强烈建议自己设一个复杂密码！后台默认对公网开放。
ADMIN_PASSWORD=

# 后台端口（浏览器访问 http://公网IP:18114）
ADMIN_PORT=18114

# 是否在系统防火墙(ufw)里放行上面的后台端口。
# true  = 放行，公网可直接访问（方便，但请务必设复杂密码）
# false = 不放行，只能通过 SSH 隧道访问（最安全）
# 注意：无论这里怎么设，云服务器【安全组】都要你自己放行才生效。
OPEN_ADMIN_FIREWALL=true
