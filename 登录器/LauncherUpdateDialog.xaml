<Window x:Class="DNFLogin.LauncherUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录器更新"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        UseLayoutRounding="True">
    <Border Background="#F020202F"
            BorderBrush="#FF3A3A4A"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6" />
        </Border.Effect>
        <StackPanel Margin="28,22,28,22">
            <TextBlock Text="登录器需要更新"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center" />
            <!-- 版本对比：让玩家一眼看出"我这版"和"服务器要的版" -->
            <TextBlock x:Name="VersionText"
                       Margin="0,10,0,0"
                       FontSize="12"
                       Foreground="#FF9F9FAF"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="HintText"
                       Margin="0,12,0,0"
                       FontSize="12"
                       Foreground="#FFE8B84A"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText"
                       Margin="0,10,0,0"
                       FontSize="13"
                       Foreground="#FFCFCFDF"
                       TextWrapping="Wrap" />
            <ProgressBar x:Name="Progress"
                         Margin="0,14,0,0"
                         Height="10"
                         Minimum="0"
                         Maximum="100"
                         Foreground="#FFE84A3A"
                         Background="#FF2A2A3A"
                         BorderThickness="0" />
            <TextBlock x:Name="PercentText"
                       Margin="0,8,0,0"
                       FontSize="12"
                       Foreground="#FF9F9FAF"
                       HorizontalAlignment="Right" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button x:Name="CancelButton"
                        Width="110"
                        Height="34"
                        Margin="0,0,10,0"
                        Background="#FF3A3A4A"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CancelButton_Click">
                    <TextBlock Text="取消" />
                </Button>
                <Button x:Name="RetryButton"
                        Width="110"
                        Height="34"
                        Background="#FFE84A3A"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        Click="RetryButton_Click">
                    <TextBlock Text="重试" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
