<UserControl x:Class="DNFLogin.GameAssistantControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        ASSIST-OFF-EXTERNAL（2026-09-20）：本页在外网版（EXTERNAL）整体停用 ——
        功能当前有问题，待修，外网版先不给玩家用；免费版（Free）一切照旧。
        XAML 不能条件编译，所以"删掉"是在代码侧做的闸门（grep ASSIST-OFF-EXTERNAL）：
          1. LoginWindow.ApplyExternalUiLock()：折叠 NavAssistant + AssistantPage；
          2. LoginWindow.Nav_Checked()：兜底拦截编程性选中该页；
          3. App.OnStartup()：不启动按键连发引擎（YHHelper.exe，与 PVF 无关）；
          4. GameAssistantControl 构造函数 / RefreshForVersion()：跳过全部初始化；
          5. LoginWindow.LaunchGameAsync()：DPS 覆盖层不启动 + 顺图/拾取共享内存门控强制写 0。
        ⚠⚠ 第 5 条**不包含** Helper DLL（DNFHelper）的注入 —— 那个 DLL 所有版本都必须注入，
           它同时是外网版 PVF 换钥补丁的载体（读 DNF_PVF_KEYSET 改写 DNF.exe 内 6 处取钥 call）。
           2026-09-20 曾把它一起关掉，导致外网版解不开加密 PVF，已回退。
        以后要修好并恢复外网版，把上面这几处 #if EXTERNAL / #if !EXTERNAL 去掉即可。
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer Margin="40,28,40,20"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="RootStack">
            <TextBlock Text="游戏助手"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="SemiBold" />

            <!-- 风险提示（一句话，别加长） -->
            <TextBlock Text="开启游戏助手功能可能导致游戏不稳定。"
                       Foreground="#FFFFB74D"
                       FontSize="12"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap" />

            <!-- DPS 伤害统计 -->
            <Border x:Name="DpsCard"
                    Background="#E6222329"
                    CornerRadius="16"
                    Margin="0,16,0,0">
                <Grid Margin="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DPS 伤害统计"
                                   Foreground="#E6FFFFFF"
                                   FontSize="13" />
                        <TextBlock Text="游戏内叠加面板，实时统计伤害输出（需要管理员权限）"
                                   Foreground="#99FFFFFF"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleButton x:Name="ToggleDps"
                                  Grid.Column="1"
                                  Style="{StaticResource SwitchStyle}"
                                  VerticalAlignment="Center"
                                  Checked="ToggleDps_Changed"
                                  Unchecked="ToggleDps_Changed" />
                </Grid>
            </Border>

            <!-- 按键连发 -->
            <Border Background="#E6222329"
                    CornerRadius="16"
                    Margin="0,20,0,0">
                <Grid Margin="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="按键连发"
                                   Foreground="#E6FFFFFF"
                                   FontSize="13" />
                        <TextBlock Text="按住指定按键自动连发，支持多组按键与独立间隔"
                                   Foreground="#99FFFFFF"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleButton x:Name="ToggleAutoFire"
                                  Grid.Column="1"
                                  Style="{StaticResource SwitchStyle}"
                                  VerticalAlignment="Center"
                                  Checked="ToggleAutoFire_Changed"
                                  Unchecked="ToggleAutoFire_Changed" />

                    <!-- 连发配置区（开关开启后显示） -->
                    <StackPanel x:Name="AutoFireConfigArea"
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="0,16,0,0"
                                Visibility="Collapsed">
                        <ItemsControl x:Name="AutoFireList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="AutoFireKeyBtn"
                                                Content="{Binding Key}"
                                                Height="34"
                                                FontSize="13"
                                                Foreground="#E6FFFFFF"
                                                Cursor="Hand"
                                                HorizontalAlignment="Left"
                                                MinWidth="110"
                                                Click="AutoFireKey_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="BtnBd"
                                                            Background="#191A1F"
                                                            BorderBrush="#2A2B31"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="14,0">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="BtnBd" Property="BorderBrush" Value="#FFE84A3A" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBlock Grid.Column="1"
                                                   Text="间隔(ms)"
                                                   Foreground="#99FFFFFF"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,8,0" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding IntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="90"
                                                 Height="34"
                                                 Background="#191A1F"
                                                 BorderBrush="#2A2B31"
                                                 BorderThickness="1"
                                                 Padding="10,0"
                                                 FontSize="13"
                                                 Foreground="White"
                                                 VerticalContentAlignment="Center"
                                                 CaretBrush="White"
                                                 TextChanged="AutoFireInterval_TextChanged" />
                                        <Button Grid.Column="2"
                                                Content="删除"
                                                Height="34"
                                                Margin="16,0,0,0"
                                                FontSize="13"
                                                Foreground="#E6FFFFFF"
                                                Cursor="Hand"
                                                Click="AutoFireRow_Delete_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="BtnBd"
                                                            Background="#3A3B40"
                                                            CornerRadius="8"
                                                            Padding="14,0">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="BtnBd" Property="Background" Value="#FFE84A3A" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ 添加按键"
                                Height="34"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                FontSize="13"
                                Foreground="#E6FFFFFF"
                                Cursor="Hand"
                                Click="AutoFireAdd_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBd"
                                            Background="#191A1F"
                                            BorderBrush="#2A2B31"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16,0">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBd" Property="BorderBrush" Value="#FFE84A3A" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock Text="点击按键按钮后按下键盘上的任意键即可录入；Esc 取消录入"
                                   Foreground="#99FFFFFF"
                                   FontSize="12"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 顺图 -->
            <Border x:Name="HelperPassCard"
                    Background="#E6222329"
                    CornerRadius="16"
                    Margin="0,20,0,0">
                <Grid Margin="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="顺图"
                                   Foreground="#E6FFFFFF"
                                   FontSize="13" />
                        <TextBlock Text="副本内按 Alt + 方向键 直接过图（双开模式下，仅主账号生效）"
                                   Foreground="#99FFFFFF"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleButton x:Name="ToggleHelperPass"
                                  Grid.Column="1"
                                  Style="{StaticResource SwitchStyle}"
                                  VerticalAlignment="Center"
                                  Checked="ToggleHelperPass_Changed"
                                  Unchecked="ToggleHelperPass_Changed" />
                </Grid>
            </Border>

            <!-- 自动拾取 -->
            <Border x:Name="HelperPickupCard"
                    Background="#E6222329"
                    CornerRadius="16"
                    Margin="0,20,0,0">
                <Grid Margin="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="自动拾取"
                                   Foreground="#E6FFFFFF"
                                   FontSize="13" />
                        <TextBlock Text="副本内自动拾取掉落物（双开模式下，仅主账号生效）"
                                   Foreground="#99FFFFFF"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleButton x:Name="ToggleHelperPickup"
                                  Grid.Column="1"
                                  Style="{StaticResource SwitchStyle}"
                                  VerticalAlignment="Center"
                                  Checked="ToggleHelperPickup_Changed"
                                  Unchecked="ToggleHelperPickup_Changed" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
