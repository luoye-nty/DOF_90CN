<Window x:Class="DNFLogin.CloseActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭登录器"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        UseLayoutRounding="True">
    <Border Background="#F020202F"
            BorderBrush="#FF3A3A4A"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6" />
        </Border.Effect>
        <StackPanel Margin="28,22,28,22">
            <TextBlock Text="关闭登录器"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center" />
            <TextBlock Text="点击右上角关闭时，希望登录器执行什么操作？"
                       Margin="0,14,0,0"
                       FontSize="14"
                       Foreground="#FFCFCFDF"
                       TextWrapping="Wrap" />
            <CheckBox x:Name="RememberBox"
                      Content="记住此选项，以后不再询问"
                      Foreground="#FFC8C8C8"
                      Margin="0,14,0,0" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,22,0,0">
                <Button Content="关闭登录器"
                        Width="116"
                        Height="34"
                        Margin="0,0,12,0"
                        Background="#FFC0392B"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ExitButton_Click" />
                <Button Content="最小化到托盘"
                        Width="116"
                        Height="34"
                        Background="#FF2ECC71"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="TrayButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
