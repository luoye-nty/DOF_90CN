<UserControl x:Class="DNFLogin.CdkRedeemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer Margin="40,28,40,20"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760"
                    HorizontalAlignment="Center">
            <TextBlock Text="CDK 兑换"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="SemiBold" />

            <!-- 兑换码输入 -->
            <Border Background="#E6222329"
                    CornerRadius="16"
                    Margin="0,16,0,0">
                <StackPanel Margin="20,16">
                    <TextBlock Text="兑换码"
                               Foreground="#E6FFFFFF"
                               FontSize="13" />
                    <TextBox x:Name="CodeTextBox"
                             Height="46"
                             Margin="0,10,0,0"
                             FontFamily="Consolas"
                             FontSize="22"
                             Foreground="White"
                             Background="#141519"
                             BorderBrush="#2E2F36"
                             CaretBrush="White"
                             BorderThickness="1"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             TextAlignment="Center"
                             MaxLength="512"
                             TextChanged="CodeTextBox_TextChanged" />
                    <!-- 实时状态：识别到就回显标准形状，识别不到就明说"可以整段粘贴"。
                         以前码框被 MaxLength 截断后按钮只会变灰、一句提示都没有，玩家只能看到"兑换不了"。 -->
                    <TextBlock x:Name="CodeStatusText"
                               Text=""
                               Foreground="#66FFFFFF"
                               FontSize="11"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="支持整段粘贴（含 卡号：/密码：/兑换码： 等标签与全角字符，自动提取）；码为 5 组 × 4 位共 20 位，仅含大写字母与数字 2-9（不含 0/O/1/I）"
                               Foreground="#66FFFFFF"
                               FontSize="11"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 账号 / 角色 -->
            <Border Background="#E6222329"
                    CornerRadius="16"
                    Margin="0,16,0,0">
                <StackPanel Margin="20,16">
                    <TextBlock x:Name="SessionStatusText"
                               Foreground="#99FFFFFF"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="兑换前请先在「开始游戏」页登录账号" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Width="230">
                            <TextBlock Text="登录账号"
                                       Foreground="#99FFFFFF"
                                       FontSize="12"
                                       Margin="0,0,0,4" />
                            <ComboBox x:Name="AccountComboBox"
                                      Height="34"
                                      FontSize="13"
                                      Style="{StaticResource DbComboStyle}"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="AccountComboBox_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Width="230"
                                    Margin="14,0,0,0">
                            <TextBlock Text="投放角色"
                                       Foreground="#99FFFFFF"
                                       FontSize="12"
                                       Margin="0,0,0,4" />
                            <ComboBox x:Name="CharacterComboBox"
                                      Height="34"
                                      FontSize="13"
                                      Style="{StaticResource DbComboStyle}"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="CharacterComboBox_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Bottom">
                            <Button x:Name="RefreshCharactersButton"
                                    Content="刷新角色"
                                    Height="34"
                                    Style="{StaticResource ServerSecondaryBtn}"
                                    Click="RefreshCharactersButton_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 手动登录（不启动游戏）：兑换前必须过账号密码，避免"只填账号就能看角色列表" -->
            <Border Background="#E6222329"
                    CornerRadius="16"
                    Margin="0,16,0,0">
                <StackPanel Margin="20,16">
                    <TextBlock Text="手动登录（不启动游戏也能兑换）"
                               Foreground="#E6FFFFFF"
                               FontSize="13" />
                    <TextBlock Text="只用于本页兑换角色列表与发放，不会启动游戏。"
                               Foreground="#66FFFFFF"
                               FontSize="11"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Width="230">
                            <TextBlock Text="账号"
                                       Foreground="#99FFFFFF"
                                       FontSize="12"
                                       Margin="0,0,0,4" />
                            <TextBox x:Name="ManualAccountTextBox"
                                     Height="34"
                                     FontSize="13"
                                     Foreground="White"
                                     Background="#141519"
                                     BorderBrush="#2E2F36"
                                     CaretBrush="White"
                                     BorderThickness="1"
                                     Padding="8,0"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Width="230"
                                    Margin="14,0,0,0">
                            <TextBlock Text="密码"
                                       Foreground="#99FFFFFF"
                                       FontSize="12"
                                       Margin="0,0,0,4" />
                            <PasswordBox x:Name="ManualPasswordBox"
                                         Height="34"
                                         FontSize="13"
                                         Foreground="White"
                                         Background="#141519"
                                         BorderBrush="#2E2F36"
                                         CaretBrush="White"
                                         BorderThickness="1"
                                         Padding="8,0"
                                         VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Bottom">
                            <Button x:Name="ManualLoginButton"
                                    Content="登录并获取角色"
                                    Height="34"
                                    MinWidth="150"
                                    Style="{StaticResource ServerSecondaryBtn}"
                                    Click="ManualLoginButton_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 兑换 -->
            <Border Background="#E6222329"
                    CornerRadius="16"
                    Margin="0,16,0,0">
                <StackPanel Margin="20,16">
                    <Button x:Name="RedeemButton"
                            Content="兑 换"
                            Height="42"
                            Width="220"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            Style="{StaticResource ServerPrimaryBtn}"
                            Click="RedeemButton_Click" />
                </StackPanel>
            </Border>

            <!-- 批量兑换（导入 txt：一行一个 20 位码） -->
            <Border Background="#E6222329"
                    CornerRadius="16"
                    Margin="0,16,0,0">
                <StackPanel Margin="20,16">
                    <TextBlock Text="批量兑换（导入 txt）"
                               Foreground="#E6FFFFFF"
                               FontSize="13" />
                    <TextBlock Text="txt 里一行一个 20 位兑换码（带不带横线都可以），也支持一行里带「卡号：/密码：/兑换码：」等中文标签的整段内容（自动抠码，一行多个码会被分别兑换）；空行自动跳过；一次最多 500 个，重复的码只会兑换一次。整批都用上面选中的账号 + 角色发放。"
                               Foreground="#66FFFFFF"
                               FontSize="11"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BatchRedeemButton"
                                Grid.Column="0"
                                Content="选择 txt 并批量兑换"
                                Height="36"
                                MinWidth="200"
                                FontSize="14"
                                Style="{StaticResource ServerPrimaryBtn}"
                                Click="BatchRedeemButton_Click" />
                        <Button x:Name="BatchCancelButton"
                                Grid.Column="1"
                                Content="取消"
                                Height="36"
                                MinWidth="90"
                                Margin="12,0,0,0"
                                Visibility="Collapsed"
                                Style="{StaticResource ServerSecondaryBtn}"
                                Click="BatchCancelButton_Click" />
                        <ProgressBar x:Name="BatchProgressBar"
                                     Grid.Column="2"
                                     Height="10"
                                     Margin="14,0,0,0"
                                     VerticalAlignment="Center"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Visibility="Collapsed" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 输出区（只读）：成功只显示 CDK 名称，失败显示原因 -->
            <Border Background="#E6222329"
                    CornerRadius="16"
                    Margin="0,16,0,0">
                <StackPanel Margin="20,16">
                    <TextBlock Text="兑换结果"
                               Foreground="#E6FFFFFF"
                               FontSize="13" />
                    <TextBox x:Name="OutputTextBox"
                             IsReadOnly="True"
                             MinHeight="90"
                             Margin="0,10,0,0"
                             Foreground="#E6FFFFFF"
                             Background="#141519"
                             BorderBrush="#2E2F36"
                             BorderThickness="1"
                             FontSize="14"
                             Padding="10,8"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             VerticalContentAlignment="Top" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
