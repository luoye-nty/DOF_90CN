<!--
    ============================================================================
    TEMP-8BOX 临时功能（临时测试用；2026-09-24 由四开扩到八开）

    ⚠ 当前状态：**启用中**（2026-09-25 按要求先关停、同日按要求重新启用）。LoginWindow.xaml.cs
      里的总开关 `Temp8BoxEnabled` 返回 true：勾选「双开」会弹出 3 号 ~ 8 号登录框（共 8 开）。
      要关掉：把那个开关的返回值改成 false 即可，本文件不用动。

    用途：开发测试用的多开。每个窗口负责一个额外槽位
    （GameProcessManager.ExtraSlot3 ~ ExtraSlot8）。

    彻底删除本功能时：
      1. 删掉本文件与 TempExtraLoginWindow.xaml.cs；
      2. 删掉 LoginWindow.xaml.cs 里所有带 TEMP-8BOX 标记的代码块（含 Temp8BoxEnabled 开关）；
      3. 删掉 Services/GameProcessManager.cs 里 TEMP-8BOX 标记的常量与槽位扩容。
    ============================================================================
-->
<Window x:Class="DNFLogin.TempExtraLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="临时多开登录"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0E0E12"
        Foreground="White">
    <Border Background="#E6222329"
            CornerRadius="14"
            Padding="20"
            Margin="12">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       Text="3 号登录"
                       Foreground="White"
                       FontSize="17"
                       FontWeight="SemiBold" />
            <TextBlock Text="【临时功能】仅开发测试用：登录后直接启动该账号的游戏进程（占 3 号 ~ 8 号槽位），验证完就删。"
                       Foreground="#99FFFFFF"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />

            <TextBlock Text="账号"
                       Foreground="#CCFFFFFF"
                       Margin="0,14,0,4" />
            <TextBox x:Name="AccountTextBox"
                     Height="32"
                     FontSize="13"
                     Padding="10,4"
                     VerticalContentAlignment="Center"
                     Background="#1FFFFFFF"
                     Foreground="White"
                     BorderBrush="#33FFFFFF"
                     BorderThickness="1"
                     KeyDown="Input_KeyDown" />

            <TextBlock Text="密码"
                       Foreground="#CCFFFFFF"
                       Margin="0,8,0,4" />
            <PasswordBox x:Name="PasswordBox"
                         Height="32"
                         FontSize="13"
                         Padding="10,4"
                         VerticalContentAlignment="Center"
                         Background="#1FFFFFFF"
                         Foreground="White"
                         BorderBrush="#33FFFFFF"
                         BorderThickness="1"
                         KeyDown="Input_KeyDown" />

            <Button x:Name="LoginButton"
                    Content="登录并启动游戏"
                    Height="38"
                    Margin="0,14,0,0"
                    FontSize="14"
                    Foreground="White"
                    Background="#FF2F6FED"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="LoginButton_Click" />

            <TextBlock x:Name="StatusText"
                       Foreground="#99FFFFFF"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       Text="填账号密码后点上面的按钮；登录成功会自动启动游戏。" />

            <Button x:Name="CloseButton"
                    Content="关闭此窗口"
                    Height="28"
                    Margin="0,12,0,0"
                    FontSize="12"
                    Foreground="#CCFFFFFF"
                    Background="#22FFFFFF"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Border>
</Window>
