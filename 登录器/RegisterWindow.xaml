<Window x:Class="DNFLogin.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="注册"
        Width="717"
        Height="580"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#CC000000"
        AllowsTransparency="True"
        BorderThickness="0"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        Loaded="Window_Loaded">
    <Grid>
        <!-- 右上角关闭按钮 -->
        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,12,12,0"
                    Panel.ZIndex="10">
            <Button x:Name="CloseButton"
                    Width="36"
                    Height="36"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CloseButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Image x:Name="CloseIcon"
                                   Source="pack://application:,,,/Assets/top-control-bar-close-icon.png"
                                   Width="22"
                                   Height="22"
                                   Stretch="Uniform" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseIcon" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- 注册表单 -->
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="400"
                    Margin="0,40,0,20">
            <TextBlock Text="注册账号"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24" />

            <!-- 账号 -->
            <StackPanel>
                <TextBlock Text="账号" Foreground="#CCFFFFFF" Margin="0,6,0,3" />
                <TextBox x:Name="AccountTextBox"
                         Height="36"
                         FontSize="14"
                         Padding="10,4"
                         VerticalContentAlignment="Center"
                         Background="#1FFFFFFF"
                         Foreground="White"
                         BorderBrush="#33FFFFFF"
                         BorderThickness="1" />
            </StackPanel>

            <!-- 密码 -->
            <StackPanel>
                <TextBlock Text="密码" Foreground="#CCFFFFFF" Margin="0,6,0,3" />
                <PasswordBox x:Name="PasswordBox"
                             Height="36"
                             FontSize="14"
                             Padding="10,4"
                             VerticalContentAlignment="Center"
                             Background="#1FFFFFFF"
                             Foreground="White"
                             BorderBrush="#33FFFFFF"
                             BorderThickness="1" />
            </StackPanel>

            <!-- 确认密码 -->
            <StackPanel>
                <TextBlock Text="确认密码" Foreground="#CCFFFFFF" Margin="0,6,0,3" />
                <PasswordBox x:Name="ConfirmPasswordBox"
                             Height="36"
                             FontSize="14"
                             Padding="10,4"
                             VerticalContentAlignment="Center"
                             Background="#1FFFFFFF"
                             Foreground="White"
                             BorderBrush="#33FFFFFF"
                             BorderThickness="1" />
            </StackPanel>

            <!-- 救援代码 -->
            <StackPanel x:Name="RescueCodePanel">
                <TextBlock Text="救援代码" Foreground="#CCFFFFFF" Margin="0,6,0,3" />
                <TextBox x:Name="RescueCodeTextBox"
                         Height="36"
                         FontSize="14"
                         Padding="10,4"
                         VerticalContentAlignment="Center"
                         Background="#1FFFFFFF"
                         Foreground="White"
                         BorderBrush="#33FFFFFF"
                         BorderThickness="1"
                         MaxLength="6" />
                <TextBlock Text="6 位数字，忘记密码时用于找回账号，请牢记"
                           Foreground="#88FFFFFF"
                           FontSize="11"
                           Margin="0,3,0,0" />
            </StackPanel>

            <!-- 注册码（邀请码）：仅当运维工具「注册需要注册码」开启时显示（默认折叠，未开启时外观与改动前完全一致） -->
            <StackPanel x:Name="RegistrationCodePanel" Visibility="Collapsed">
                <TextBlock Text="注册码" Foreground="#CCFFFFFF" Margin="0,6,0,3" />
                <TextBox x:Name="RegistrationCodeTextBox"
                         Height="36"
                         FontSize="14"
                         Padding="10,4"
                         VerticalContentAlignment="Center"
                         Background="#1FFFFFFF"
                         Foreground="White"
                         BorderBrush="#33FFFFFF"
                         BorderThickness="1"
                         MaxLength="24" />
                <TextBlock Text="由管理员发放，形如 ABCD-EFGH；一枚只能用一次，不分大小写、横线可省略"
                           Foreground="#88FFFFFF"
                           FontSize="11"
                           Margin="0,3,0,0" />
            </StackPanel>

            <!-- 验证码 -->
            <StackPanel>
                <TextBlock Text="验证码" Foreground="#CCFFFFFF" Margin="0,6,0,3" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CaptchaTextBox"
                             Grid.Column="0"
                             Height="36"
                             FontSize="14"
                             Padding="10,4"
                             VerticalContentAlignment="Center"
                             Background="#1FFFFFFF"
                             Foreground="White"
                             BorderBrush="#33FFFFFF"
                             BorderThickness="1"
                             Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Width="110"
                                Height="36"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1">
                            <Image x:Name="CaptchaImage"
                                   Stretch="Fill"
                                   Cursor="Hand"
                                   MouseDown="CaptchaImage_MouseDown" />
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- 按钮 -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0">
                <Button Content="返回登录"
                        Width="120"
                        Height="40"
                        Margin="0,0,12,0"
                        Background="#00000000"
                        Foreground="#FF2ECC71"
                        BorderBrush="#FF2ECC71"
                        BorderThickness="1.5"
                        FontSize="15"
                        Cursor="Hand"
                        Click="BackToLogin_Click" />
                <Button x:Name="RegisterSubmitButton"
                        Content="注 册"
                        Width="140"
                        Height="40"
                        Background="#FF2ECC71"
                        Foreground="White"
                        FontSize="15"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="RegisterButton_Click" />
            </StackPanel>
        </StackPanel>

        <!-- 状态提示覆盖层 -->
        <Grid x:Name="RegisterStatusOverlay"
              Visibility="Collapsed"
              Background="#99000000"
              Panel.ZIndex="2"
              MouseDown="StatusOverlay_MouseDown">
            <Border x:Name="RegisterStatusPanel"
                    Background="#F018181C"
                    Padding="24"
                    CornerRadius="14"
                    Width="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MouseDown="StatusPanel_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" Opacity="0.5" ShadowDepth="0" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="StatusTitleText"
                               Text="提示"
                               Foreground="#FFFFFFFF"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBlock x:Name="StatusBodyText"
                               Foreground="#F0FFFFFF"
                               FontSize="15"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />
                    <Button Content="我知道了"
                            Height="36"
                            Background="#FF2ECC71"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="15"
                            Cursor="Hand"
                            Click="StatusCloseButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>