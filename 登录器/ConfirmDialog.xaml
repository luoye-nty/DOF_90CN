<Window x:Class="DNFLogin.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        UseLayoutRounding="True">
    <Border Background="#F020202F"
            BorderBrush="#FF3A3A4A"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6" />
        </Border.Effect>
        <StackPanel Margin="28,22,28,22">
            <TextBlock x:Name="TitleText"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="MessageText"
                       Margin="0,14,0,0"
                       FontSize="14"
                       Foreground="#FFCFCFDF"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,22,0,0">
                <Button x:Name="CancelButton"
                        Width="100"
                        Height="34"
                        Margin="0,0,12,0"
                        Background="#FF3A3A4A"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CancelButton_Click" />
                <Button x:Name="ConfirmButton"
                        Width="100"
                        Height="34"
                        Background="#FFE84A3A"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ConfirmButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
