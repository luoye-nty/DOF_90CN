<Window x:Class="DNFLogin.StartServerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="服务端状态"
        Width="480"
        Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#FF1E1E2E"
        ShowInTaskbar="False">
    <Border BorderBrush="#FF3A3A4A"
            BorderThickness="1"
            CornerRadius="8"
            Background="#FF20202F">
        <StackPanel Margin="28,20">
            <TextBlock Text="服务端状态"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center" />
            <TextBlock Text="请确认各版本服务端状态，可对未启动的版本一键开启。"
                       Margin="0,14,0,4"
                       Foreground="#FFCFCFDF"
                       TextWrapping="Wrap" />

            <!-- 90 版 -->
            <Border x:Name="Row90"
                    Background="#FF262638"
                    CornerRadius="8"
                    Margin="0,12,0,0"
                    Padding="14,10">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="Name90"
                                   Text="90 版"
                                   FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock x:Name="Status90"
                                   Text="检测中..."
                                   FontSize="12"
                                   Foreground="#FFCFCFDF"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Button x:Name="Start90Button"
                            Content="启动"
                            Width="80"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="#FF2E7D32"
                            Foreground="White"
                            Visibility="Collapsed"
                            Click="Start90Button_Click" />
                </Grid>
            </Border>

            <!-- S4A21 版 -->
            <Border x:Name="RowA21"
                    Background="#FF262638"
                    CornerRadius="8"
                    Margin="0,10,0,0"
                    Padding="14,10">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="NameA21"
                                   Text="S4A21 版"
                                   FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock x:Name="StatusA21"
                                   Text="检测中..."
                                   FontSize="12"
                                   Foreground="#FFCFCFDF"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Button x:Name="StartA21Button"
                            Content="启动"
                            Width="80"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="#FF2E7D32"
                            Foreground="White"
                            Visibility="Collapsed"
                            Click="StartA21Button_Click" />
                </Grid>
            </Border>

            <!-- S4A12 版 -->
            <Border x:Name="RowA12"
                    Background="#FF262638"
                    CornerRadius="8"
                    Margin="0,10,0,0"
                    Padding="14,10">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="NameA12"
                                   Text="S4A12 版"
                                   FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock x:Name="StatusA12"
                                   Text="检测中..."
                                   FontSize="12"
                                   Foreground="#FFCFCFDF"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Button x:Name="StartA12Button"
                            Content="启动"
                            Width="80"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="#FF2E7D32"
                            Foreground="White"
                            Visibility="Collapsed"
                            Click="StartA12Button_Click" />
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,22,0,0">
                <Button x:Name="CloseButton"
                        Content="完成"
                        Width="88"
                        Height="32"
                        Background="#FF3A3A4A"
                        Foreground="White"
                        Click="CloseButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
