<UserControl x:Class="DNFLogin.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1200">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 子导航：基础设置 / 导出导入 / 关于 -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="40,0,0,0">
            <RadioButton x:Name="NavBase"
                         Content="基础设置"
                         GroupName="SettingsSubNav"
                         Style="{StaticResource SubNavRadioStyle}"
                         IsChecked="True" />
            <RadioButton x:Name="NavTransfer"
                         Content="备份/导入数据"
                         GroupName="SettingsSubNav"
                         Style="{StaticResource SubNavRadioStyle}"
                         Margin="24,0,0,0" />
            <RadioButton x:Name="NavAbout"
                         Content="关于"
                         GroupName="SettingsSubNav"
                         Style="{StaticResource SubNavRadioStyle}"
                         Margin="24,0,0,0" />
        </StackPanel>

        <!-- 内容区 -->
        <Grid Grid.Row="1">
            <!-- 基础设置 -->
            <Grid x:Name="PageSettings"
                  Margin="40,28,40,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Row="0"
                           Text="基础设置"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold" />

                <!-- 退出游戏时弹出 -->
                <Border Grid.Row="1"
                        Background="#222329"
                        CornerRadius="16"
                        Margin="0,20,0,0">
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="退出游戏时弹出"
                                   Foreground="#E6FFFFFF"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                        <ToggleButton x:Name="ToggleExitPopup"
                                      Grid.Column="1"
                                      HorizontalAlignment="Right"
                                      IsChecked="True"
                                      Style="{StaticResource SwitchStyle}" />
                    </Grid>
                </Border>

                <!-- 关闭窗口 -->
                <Border Grid.Row="2"
                        Background="#222329"
                        CornerRadius="16"
                        Margin="0,20,0,0">
                    <Grid Margin="18,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="关闭窗口"
                                   Foreground="#E6FFFFFF"
                                   FontSize="13" />
                        <RadioButton x:Name="RadioTray"
                                     Grid.Row="1"
                                     Content="最小化到系统托盘"
                                     GroupName="CloseBehavior"
                                     Style="{StaticResource RadioStyle}"
                                     Checked="CloseBehavior_Checked"
                                     Margin="0,12,0,0" />
                        <RadioButton x:Name="RadioExit"
                                     Grid.Row="2"
                                     Content="退出启动器"
                                     GroupName="CloseBehavior"
                                     Style="{StaticResource RadioStyle}"
                                     Checked="CloseBehavior_Checked"
                                     Margin="0,10,0,0" />
                    </Grid>
                </Border>

                <!-- 背景设置 -->
                <Border Grid.Row="3"
                        Background="#222329"
                        CornerRadius="16"
                        Margin="0,20,0,0">
                    <Grid Margin="18,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="背景设置"
                                   Foreground="#E6FFFFFF"
                                   FontSize="13" />
                        <TextBlock Grid.Row="1"
                                   Text="自定义图片目录（留空则轮换内置背景图）"
                                   Foreground="#99FFFFFF"
                                   FontSize="11"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />

                        <!-- 目录输入框 + 选择按钮 -->
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Background="#2A2B31"
                                    BorderBrush="#2A2B31"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Height="34">
                                <TextBox x:Name="BackgroundFolderBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="10,0"
                                         FontSize="12"
                                         Foreground="White"
                                         VerticalContentAlignment="Center"
                                         CaretBrush="White"
                                         TextChanged="BackgroundFolderBox_TextChanged" />
                            </Border>

                            <Button x:Name="BrowseBackgroundButton"
                                    Grid.Column="1"
                                    Content="选择目录"
                                    Height="34"
                                    Margin="10,0,0,0"
                                    FontSize="12"
                                    Foreground="White"
                                    Cursor="Hand"
                                    Click="BrowseBackgroundButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BtnBd"
                                                Background="#FFE84A3A"
                                                CornerRadius="8"
                                                Padding="16,0">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBd" Property="Opacity" Value="0.55" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="BtnBd" Property="Opacity" Value="0.75" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- 轮播设置：设置图片目录后才可用 -->
                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    Margin="0,12,0,0">
                            <TextBlock Text="轮播设置"
                                       Foreground="#E6FFFFFF"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                            <RadioButton x:Name="RadioBgSequential"
                                         Content="顺序轮播"
                                         GroupName="BgOrder"
                                         Style="{StaticResource RadioStyle}"
                                         Checked="BgOrder_Checked"
                                         Margin="16,0,0,0" />
                            <RadioButton x:Name="RadioBgShuffle"
                                         Content="随机轮播"
                                         GroupName="BgOrder"
                                         Style="{StaticResource RadioStyle}"
                                         Checked="BgOrder_Checked"
                                         Margin="16,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 清除所有配置（危险操作） -->
                <Button x:Name="ClearAllConfigButton"
                        Grid.Row="4"
                        Content="清除所有配置"
                        Height="36"
                        FontSize="13"
                        Foreground="White"
                        Cursor="Hand"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,14,0,0"
                        Click="ClearAllConfigButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBd"
                                    Background="#6E1A16"
                                    BorderBrush="#FFE84A3A"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20,0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBd" Property="Background" Value="#8A241D" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBd" Property="Opacity" Value="0.75" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 导出 / 导入 -->
            <Grid x:Name="PageTransfer" Visibility="Collapsed">
                <ScrollViewer Margin="40,28,40,20"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <!-- 细滚动条：滑轨与上下箭头隐形，仅 4px 滑块 -->
                        <Style TargetType="{x:Type ScrollBar}">
                            <Setter Property="Width" Value="4" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                                        <Grid Background="Transparent">
                                            <Grid.RenderTransform>
                                                <TranslateTransform X="15" />
                                            </Grid.RenderTransform>
                                            <Track x:Name="PART_Track"
                                                   IsDirectionReversed="True">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                                  Opacity="0"
                                                                  Focusable="False"
                                                                  IsTabStop="False" />
                                                </Track.DecreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb>
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                                <Border x:Name="ThumbBd"
                                                                        Background="#36373A"
                                                                        CornerRadius="2"
                                                                        Margin="0,2"
                                                                        Width="4"
                                                                        HorizontalAlignment="Center" />
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                                  Opacity="0"
                                                                  Focusable="False"
                                                                  IsTabStop="False" />
                                                </Track.IncreaseRepeatButton>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <TextBlock Text="导出 / 导入"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="数据库全库备份与恢复，不支持 MySQL / SQLite 互导，导出的数据只能导入至对应数据库。"
                                   Foreground="#99FFFFFF"
                                   FontSize="12"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />

                        <!-- 导出卡片 -->
                        <Border Background="#222329"
                                CornerRadius="16"
                                Margin="0,20,0,0">
                            <StackPanel Margin="18,16">
                                <TextBlock Text="导出数据库备份"
                                           Foreground="#E6FFFFFF"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="将当前配置的数据库全库导出为通用 SQL（dump.sql + meta.json）并打包为 zip 文件。"
                                           Foreground="#80FFFFFF"
                                           FontSize="12"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap" />
                                <Button x:Name="ExportDbButton"
                                        Content="导出备份"
                                        Height="36"
                                        Margin="0,14,0,0"
                                        HorizontalAlignment="Left"
                                        Padding="20,0"
                                        FontSize="13"
                                        Foreground="White"
                                        Cursor="Hand"
                                        Click="ExportDbButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="BtnBd"
                                                    Background="#191A1F"
                                                    BorderBrush="#2A2B31"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BtnBd" Property="Opacity" Value="0.85" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- 导入卡片 -->
                        <Border Background="#222329"
                                CornerRadius="16"
                                Margin="0,20,0,0">
                            <StackPanel Margin="18,16">
                                <TextBlock Text="导入数据库备份"
                                           Foreground="#E6FFFFFF"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="选择 zip 备份恢复全库。将校验备份完整性，导入前展示目标库信息并询问备份原库；同名表冲突可选覆盖 / 跳过 / 改名。"
                                           Foreground="#80FFFFFF"
                                           FontSize="12"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap" />
                                <Button x:Name="ImportDbButton"
                                        Content="导入备份"
                                        Height="36"
                                        Margin="0,14,0,0"
                                        HorizontalAlignment="Left"
                                        Padding="20,0"
                                        FontSize="13"
                                        Foreground="White"
                                        Cursor="Hand"
                                        Click="ImportDbButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="BtnBd"
                                                    Background="#191A1F"
                                                    BorderBrush="#2A2B31"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BtnBd" Property="Opacity" Value="0.85" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- 进度/结果 -->
                        <Border Background="#222329"
                                CornerRadius="16"
                                Margin="0,20,0,0">
                            <StackPanel Margin="18,16">
                                <TextBlock Text="进度 / 结果"
                                           Foreground="#E6FFFFFF"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <Border Background="#191A1F"
                                        CornerRadius="8"
                                        Margin="0,10,0,0"
                                        Height="150">
                                    <TextBox x:Name="DbTransferLogBox"
                                             IsReadOnly="True"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="10,8"
                                             FontSize="12"
                                             Foreground="#B8FFFFFF"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"
                                             TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 关于 -->
            <Grid x:Name="PageAbout" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 版本号由 SettingsControl.xaml.cs 用 LauncherVersion.DisplayText 填充。
                         ★ 不要在这里写死版本号：那是登录器上报给运维工具做版本校验的同一个值，
                           写死会漂移，导致"关于页显示 1.5.5、实际自检上报却是别的值"这种排查噩梦。
                           改版本号请改 LauncherVersion.cs 的 Current。 -->
                    <TextBlock x:Name="AboutVersionText"
                               Text="落叶登陆器"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="本工具仅做学习与研究使用，不得用于包括但不限于非法盈利及任何非法用途。"
                               Foreground="#99FFFFFF"
                               FontSize="13"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="本工具所使用的素材、标志等著作权均归各著作权人（单位）所有。"
                               Foreground="#99FFFFFF"
                               FontSize="13"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="本工具请下载后于24小时内删除，如因违反相关法律法规出现任何后果自行承担，工具开发者不承担任何责任。使用本工具则默认您同意本规则，如不同意请立即删除本工具。"
                               Foreground="#99FFFFFF"
                               FontSize="13"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center" />
                    <!-- 交流群（Discord）：仅免费版显示；外网版在构造函数里整行折叠（#if EXTERNAL）。
                         用 Hyperlink 而非纯文本：点一下就用默认浏览器打开邀请链接，玩家不用手动复制。
                         NavigateUri 只用于展示与兜底，真正拉起浏览器的是
                         AboutDcLink_RequestNavigate（见 SettingsControl.xaml.cs）——
                         本项目是普通 Window，没有 NavigationService，不自己处理点击会没有反应。 -->
                    <TextBlock x:Name="AboutDcLinkText"
                               Foreground="#99FFFFFF"
                               FontSize="13"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center">
                        <Run Text="DC群：" Foreground="#99FFFFFF" />
                        <Hyperlink NavigateUri="https://discord.gg/kxppgMyT7"
                                   RequestNavigate="AboutDcLink_RequestNavigate"
                                   Foreground="#4FA8FF"
                                   Cursor="Hand"><Run Text="https://discord.gg/kxppgMyT7" /></Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
