<UserControl x:Class="DNFLogin.DllManageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="40,28,40,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="DLL 管理"
                   Foreground="White"
                   FontSize="18"
                   FontWeight="SemiBold" />

        <Border Background="#E6222329"
                CornerRadius="16"
                Margin="0,28,0,0">
            <StackPanel Margin="20,16">
                <TextBlock Text="注入说明"
                           Foreground="#E6FFFFFF"
                           FontSize="13" />
                <TextBlock Text="勾选的 DLL 将在启动游戏后自动注入 DNF.exe 进程。需要管理员权限运行登录器，否则注入会失败。"
                           Foreground="#99FFFFFF"
                           FontSize="12"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="注入列表"
                       Foreground="#E6FFFFFF"
                       FontSize="13"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="SelectDllButton"
                        Content="+ 选择 DLL"
                        Height="32"
                        Margin="0,0,10,0"
                        FontSize="13"
                        Foreground="White"
                        Cursor="Hand"
                        Click="SelectDllButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBd"
                                    Background="#FFE84A3A"
                                    CornerRadius="8"
                                    Padding="16,0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBd" Property="Background" Value="#FFC63B2E" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3"
                Background="#E6222329"
                CornerRadius="16"
                Margin="0,12,0,0">
            <ListBox x:Name="DllList"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#E6FFFFFF"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#14151A" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center"
                                      Foreground="#E6FFFFFF"
                                      Checked="DllEnable_Changed"
                                      Unchecked="DllEnable_Changed" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Path}"
                                       Foreground="#E6FFFFFF"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Path}" />
                            <Button Grid.Column="2"
                                    Content="移除"
                                    Height="26"
                                    FontSize="12"
                                    Foreground="#E6FFFFFF"
                                    Cursor="Hand"
                                    Click="DllRemove_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BtnBd"
                                                Background="#3A3B40"
                                                CornerRadius="6"
                                                Padding="10,0">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBd" Property="Background" Value="#FFE84A3A" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Grid.Row="4"
                   Text="共 0 个 DLL"
                   x:Name="DllCountText"
                   Foreground="#99FFFFFF"
                   FontSize="12"
                   Margin="0,10,0,0" />
    </Grid>
</UserControl>
