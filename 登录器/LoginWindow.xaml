<adu:AduWindow x:Class="DNFLogin.LoginWindow"
               x:Name="RootWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:adu="clr-namespace:AduSkin.Controls.Metro;assembly=AduSkin"
               xmlns:local="clr-namespace:DNFLogin"
               xmlns:gm="clr-namespace:DNFLogin.Gm"
               Title="落叶DNF登录器"
               Icon="pack://application:,,,/Assets/DNF.ico"
               Width="1280"
               Height="728"
               ResizeMode="NoResize"
               WindowStyle="None"
               SysButtonVisible="Collapsed"
               Background="#FF080C18"
               AllowsTransparency="False"
               BorderThickness="0"
               UseLayoutRounding="True"
               WindowStartupLocation="CenterScreen"
               Loaded="Window_Loaded">

    <adu:AduWindow.Resources>
        <!-- 顶部导航条按钮样式：饱满圆角长条，选中红色下划线 + 微亮背景 -->
        <Style x:Key="TopNavRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CCFFFFFF" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bd"
                                    CornerRadius="8"
                                    Background="Transparent"
                                    Padding="30,10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <Rectangle x:Name="Underline"
                                       Height="3"
                                       Fill="#FFE84A3A"
                                       RadiusX="1.5"
                                       RadiusY="1.5"
                                       Margin="22,0"
                                       VerticalAlignment="Bottom"
                                       Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF" />
                                <Setter TargetName="Underline" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 版本选择项样式：50x50 图标方块，选中红色描边 -->
        <Style x:Key="VersionRadioStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="0" />
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Width="50"
                                Height="50"
                                Background="#14FFFFFF"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="8"
                                Padding="2">
                            <Image Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                   Width="44"
                                   Height="44"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#55FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFE84A3A" />
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 版本悬停信息框样式：无默认 ToolTip 外壳，仅显示自定义内容 -->
        <Style x:Key="VersionTooltipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HasDropShadow" Value="False" />
        </Style>
    </adu:AduWindow.Resources>

    <Grid Background="#FF080C18">
        <!-- 窗口背景层 -->
        <Grid x:Name="RootContainer"
              Grid.RowSpan="2"
              ClipToBounds="True"
              Background="#FF101014"
              Opacity="0"
              MouseLeftButtonDown="RootContainer_MouseLeftButtonDown">
            <!-- 轮换背景双图层：Fill 拉伸铺满全窗，完整显示不裁剪，任意分辨率无黑边 -->
            <Image x:Name="BackgroundLayer1"
                   Stretch="Fill"
                   IsHitTestVisible="False" />
            <Image x:Name="BackgroundLayer2"
                   Stretch="Fill"
                   IsHitTestVisible="False"
                   Opacity="0" />
        </Grid>

        <!-- 玻璃层：铺满导航条下方全部区域，仅开始游戏页隐藏 -->
        <Border x:Name="GlassOverlay"
                Grid.RowSpan="2"
                Margin="0,68,0,0"
                Background="#C8101014"
                Panel.ZIndex="2"
                Visibility="Collapsed" />

        <Image Source="pack://application:,,,/Assets/logo.png"
               Height="56"
               Stretch="Uniform"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Margin="112,20,0,0"
               Panel.ZIndex="1" />

        <!-- 右上角：最小化 / 关闭 -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,12,12,0"
                    Panel.ZIndex="10">
            <Button x:Name="MinimizeButton"
                    Width="36"
                    Height="36"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="MinimizeButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Image x:Name="MinIcon"
                                   Source="pack://application:,,,/Assets/top-control-bar-minimize-icon.png"
                                   Width="22"
                                   Height="22"
                                   Stretch="Uniform" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MinIcon" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="CloseButton"
                    Width="36"
                    Height="36"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CloseButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Image x:Name="CloseIcon"
                                   Source="pack://application:,,,/Assets/top-control-bar-close-icon.png"
                                   Width="22"
                                   Height="22"
                                   Stretch="Uniform" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseIcon" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- 顶部居中导航条 -->
        <Border Grid.RowSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,12,0,0"
                Background="#CC141419"
                CornerRadius="22"
                Padding="10,7"
                Panel.ZIndex="10">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="NavGame"
                             Content="开始游戏"
                             GroupName="TopNav"
                             Style="{StaticResource TopNavRadioStyle}"
                             Checked="Nav_Checked" />
                <RadioButton x:Name="NavConfig"
                             Visibility="Collapsed"
                             Content="游戏配置"
                             GroupName="TopNav"
                             Style="{StaticResource TopNavRadioStyle}"
                             Margin="6,0,0,0"
                             Checked="Nav_Checked" />
                <RadioButton x:Name="NavAssistant"
                             Content="游戏助手"
                             GroupName="TopNav"
                             Style="{StaticResource TopNavRadioStyle}"
                             Margin="6,0,0,0"
                             Checked="Nav_Checked" />
                <RadioButton x:Name="NavDll"
                             Visibility="Collapsed"
                             Content="DLL管理"
                             GroupName="TopNav"
                             Style="{StaticResource TopNavRadioStyle}"
                             Margin="6,0,0,0"
                             Checked="Nav_Checked" />
                <RadioButton x:Name="NavGm"
                             Visibility="Collapsed"
                             Content="GM工具"
                             GroupName="TopNav"
                             Style="{StaticResource TopNavRadioStyle}"
                             Margin="6,0,0,0"
                             Checked="Nav_Checked" />
                <RadioButton x:Name="NavCdk"
                             Content="CDK兑换"
                             GroupName="TopNav"
                             Style="{StaticResource TopNavRadioStyle}"
                             Margin="6,0,0,0"
                             Checked="Nav_Checked" />
                <RadioButton x:Name="NavSettings"
                             Content="设置"
                             GroupName="TopNav"
                             Style="{StaticResource TopNavRadioStyle}"
                             Margin="6,0,0,0"
                             Checked="Nav_Checked" />
            </StackPanel>
        </Border>

        <!-- 页面容器：5 页常驻内存，Visibility 切换 -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="3">
            <!-- 开始游戏页：原登录界面（位置不变） -->
            <Grid x:Name="PageLogin">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>

                <!-- 版本选择面板：三个版本图标竖排（切换功能待做；外网版 M3 整体折叠）
                     2026-10-15：本构建只保留第一个版本（90），此面板整体隐藏不显示（保留元素以便外网版代码仍可编译）；
                     同日登录框上方的 S5A11 版本标签（LoginVersionText）已整块删除 -->
                <Border x:Name="VersionPanel"
                        Visibility="Collapsed"
                        Grid.RowSpan="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="26,26,0,0"
                        Width="76"
                        Height="675"
                        Background="#B0101015"
                        CornerRadius="16"
                        Padding="8,10"
                        Panel.ZIndex="5">
                    <DockPanel>
                        <Image DockPanel.Dock="Top"
                               Source="pack://application:,,,/Assets/icon-collectionl.png"
                               Width="56"
                               Height="31"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6" />
                        <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="选择版本"
                                   Foreground="#CCFFFFFF"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12" />
                        <RadioButton x:Name="VersionRadio90"
                                     Content="90"
                                     Tag="pack://application:,,,/Assets/DNF_90.png"
                                     GroupName="VersionGroup"
                                     Style="{StaticResource VersionRadioStyle}"
                                     Checked="VersionRadio_Checked"
                                     ToolTipService.Placement="Right"
                                     ToolTipService.HorizontalOffset="15"
                                     ToolTipService.VerticalOffset="-9"
                                     IsChecked="True">
                            <RadioButton.ToolTip>
                                <ToolTip Style="{StaticResource VersionTooltipStyle}">
                                    <Border Width="157"
                                            Height="68"
                                            Background="#E6101015"
                                            CornerRadius="8">
                                        <TextBlock Text="S5A11"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </ToolTip>
                            </RadioButton.ToolTip>
                        </RadioButton>
                        <RadioButton x:Name="VersionRadioS4A21"
                                     Content="S4A21"
                                     Tag="pack://application:,,,/Assets/DNF_S4A21.png"
                                     GroupName="VersionGroup"
                                     Style="{StaticResource VersionRadioStyle}"
                                     Checked="VersionRadio_Checked"
                                     ToolTipService.Placement="Right"
                                     ToolTipService.HorizontalOffset="15"
                                     ToolTipService.VerticalOffset="-9"
                                     Margin="0,20,0,0">
                            <RadioButton.ToolTip>
                                <ToolTip Style="{StaticResource VersionTooltipStyle}">
                                    <Border Width="157"
                                            Height="68"
                                            Background="#E6101015"
                                            CornerRadius="8">
                                        <TextBlock Text="S4A21"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </ToolTip>
                            </RadioButton.ToolTip>
                        </RadioButton>
                        <RadioButton x:Name="VersionRadioS4A12"
                                     Content="S4A12"
                                     Tag="pack://application:,,,/Assets/DNF_S4A12.png"
                                     GroupName="VersionGroup"
                                     Style="{StaticResource VersionRadioStyle}"
                                     Checked="VersionRadio_Checked"
                                     ToolTipService.Placement="Right"
                                     ToolTipService.HorizontalOffset="15"
                                     ToolTipService.VerticalOffset="-9"
                                     Margin="0,20,0,0">
                            <RadioButton.ToolTip>
                                <ToolTip Style="{StaticResource VersionTooltipStyle}">
                                    <Border Width="157"
                                            Height="68"
                                            Background="#E6101015"
                                            CornerRadius="8">
                                        <TextBlock Text="S4A12"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </ToolTip>
                            </RadioButton.ToolTip>
                        </RadioButton>
                    </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Rectangle RadiusX="16" RadiusY="16"
                               Width="348"
                               Margin="0,-115,40,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center">
                        <Rectangle.Fill>
                            <VisualBrush Visual="{Binding ElementName=RootContainer}" Stretch="UniformToFill" />
                        </Rectangle.Fill>
                        <Rectangle.Effect>
                            <BlurEffect Radius="18" />
                        </Rectangle.Effect>
                    </Rectangle>

                    <!-- 主/副登录框容器：双开勾选后左侧出现副登录框 -->
                    <StackPanel x:Name="LoginPanelsContainer"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,-115,40,0">

                        <!-- 服务器公告栏：管理工具「服务器公告」维护的公告板（标题 + 日期）。
                             由 LoginWindow.xaml.cs 从 /launcher/v1/notices 拉取后填充；
                             服务器上一条公告都没有时整块隐藏（不占位、不显示空框）。
                             双开时收窄到 300，避免 1280 宽下与左侧版本面板重叠。
                             位置微调：RenderTransform 只做视觉平移（默认 X=-320 / 双开时由
                              UpdateNoticePanelWidth 收到 -200，Y=60），不参与布局计算 ——
                              既不影响"双开时收窄"，也不会把登录框挤走；
                              平移量不能超过双开时布局槽的起点（244），否则左边会被窗口裁掉。 -->
                        <Border x:Name="ServerNoticePanel"
                                Width="520"
                                Height="290"
                                Margin="0,0,14,0"
                                Background="#B0101015"
                                CornerRadius="16"
                                Padding="22,18"
                                Visibility="Collapsed">
                            <Border.RenderTransform>
                                <TranslateTransform X="-320" Y="60" />
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Rectangle Width="4"
                                               Height="18"
                                               RadiusX="2"
                                               RadiusY="2"
                                               Fill="#FFE84A3A"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="服务器公告"
                                               Foreground="White"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="ServerNoticeUpdatedText"
                                               Foreground="#80FFFFFF"
                                               FontSize="11"
                                               Margin="10,0,0,2"
                                               VerticalAlignment="Bottom" />
                                </StackPanel>

                                <!-- 公告行由代码生成（日期 + 标题），条目多时纵向滚动 -->
                                <ScrollViewer Grid.Row="1"
                                              Margin="0,12,0,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="ServerNoticeList" />
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- 副登录框（仅主框勾选"双开"时显示） -->
                        <Border x:Name="SecondaryLoginPanel"
                                Background="#B0101015"
                                Padding="24"
                                CornerRadius="16"
                                Width="320"
                                Margin="0,0,14,0"
                                Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="双开登录"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />

                                <StackPanel>
                                    <TextBlock Text="副账号"
                                            Foreground="#CCFFFFFF"
                                            Margin="0,6,0,4" />
                                    <TextBox x:Name="SecondaryAccountTextBox"
                                             Height="32"
                                             FontSize="13"
                                             Padding="10,4"
                                             VerticalContentAlignment="Center"
                                             Background="#1FFFFFFF"
                                             Foreground="White"
                                             BorderBrush="#33FFFFFF"
                                             BorderThickness="1"
                                             KeyDown="LoginInput_KeyDown" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="密码"
                                            Foreground="#CCFFFFFF"
                                            Margin="0,6,0,4" />
                                    <PasswordBox x:Name="SecondaryPasswordBox"
                                                 Height="32"
                                                 FontSize="13"
                                                 Padding="10,4"
                                                 VerticalContentAlignment="Center"
                                                 Background="#1FFFFFFF"
                                                 Foreground="White"
                                                 BorderBrush="#33FFFFFF"
                                                 BorderThickness="1"
                                                 KeyDown="LoginInput_KeyDown" />
                                </StackPanel>

                                <TextBlock x:Name="SecondaryLoggedInText"
                                           Foreground="#FF2ECC71"
                                           FontSize="12"
                                           Margin="2,8,0,0"
                                           Visibility="Collapsed" />

                                <Button x:Name="SecondaryLoginButton"
                                        Content="副账号登录"
                                        Height="36"
                                        Foreground="White"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        BorderThickness="0"
                                        Margin="0,14,0,0"
                                        Cursor="Hand"
                                        Click="SecondaryLoginButton_Click">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFE84A3A" Offset="0" />
                                            <GradientStop Color="#FFC62828" Offset="1" />
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    CornerRadius="10"
                                                    Background="{TemplateBinding Background}"
                                                    BorderThickness="0">
                                                <Grid>
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                    <Border x:Name="HoverOverlay"
                                                            CornerRadius="10"
                                                            Background="#45FFFFFF"
                                                            Opacity="0" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HoverOverlay" Property="Opacity" Value="1" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FF9E9E9E" />
                                                    <Setter TargetName="HoverOverlay" Property="Opacity" Value="0" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- 主登录框 -->
                        <Border Background="#B0101015"
                                Padding="26"
                                CornerRadius="16"
                                Width="348">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,14">
                                    <TextBlock Text="登录游戏"
                                               Foreground="White"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel x:Name="LoginFormPanel">
                                    <TextBlock Text="账号"
                                            Foreground="#CCFFFFFF"
                                            Margin="0,8,0,4" />
                                    <TextBox x:Name="AccountTextBox"
                                             Height="32"
                                             FontSize="13"
                                             Padding="10,4"
                                             VerticalContentAlignment="Center"
                                             Background="#1FFFFFFF"
                                             Foreground="White"
                                             BorderBrush="#33FFFFFF"
                                             BorderThickness="1"
                                             KeyDown="LoginInput_KeyDown" />

                                <StackPanel>
                                    <TextBlock Text="密码"
                                            Foreground="#CCFFFFFF"
                                            Margin="0,8,0,4" />
                                    <PasswordBox x:Name="PasswordBox"
                                                 Height="32"
                                                 FontSize="13"
                                                 Padding="10,4"
                                                 VerticalContentAlignment="Center"
                                                 Background="#1FFFFFFF"
                                                 Foreground="White"
                                                 BorderBrush="#33FFFFFF"
                                                 BorderThickness="1"
                                                 KeyDown="LoginInput_KeyDown" />
                                </StackPanel>

                                <TextBlock x:Name="MainLoggedInText"
                                           Foreground="#FF2ECC71"
                                           FontSize="12"
                                           Margin="2,8,0,0"
                                           Visibility="Collapsed" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <CheckBox x:Name="RememberCheckBox"
                                              Content="记住密码"
                                              Foreground="#CCFFFFFF" />
                                    <CheckBox x:Name="DualCheckBox"
                                              Content="双开"
                                              Foreground="#CCFFFFFF"
                                              Margin="14,0,0,0"
                                              Cursor="Hand"
                                              Checked="DualCheckBox_Checked"
                                              Unchecked="DualCheckBox_Unchecked" />
                                    <Button x:Name="ClearButton"
                                            Content="清除"
                                            Foreground="#FFE84A3A"
                                            FontSize="12"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Margin="10,0,0,0"
                                            Cursor="Hand"
                                            ToolTip="清除主/副账号密码及已保存的凭据"
                                            Click="ClearButton_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" Padding="4,2">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>

                                <Button x:Name="LoginButton"
                                        Content="登 录"
                                        Height="36"
                                        Foreground="White"
                                        FontSize="15"
                                        FontWeight="Bold"
                                        BorderThickness="0"
                                        Margin="0,12,0,6"
                                        Cursor="Hand"
                                        IsDefault="True"
                                        Click="LoginButton_Click">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFE84A3A" Offset="0" />
                                            <GradientStop Color="#FFC62828" Offset="1" />
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <Button.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.45" Color="#FFC62828" />
                                    </Button.Effect>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    CornerRadius="10"
                                                    Background="{TemplateBinding Background}"
                                                    BorderThickness="0">
                                                <Grid>
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                    <Border x:Name="HoverOverlay"
                                                            CornerRadius="10"
                                                            Background="#45FFFFFF"
                                                            Opacity="0" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HoverOverlay" Property="Opacity" Value="1" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FF9E9E9E" />
                                                    <Setter TargetName="HoverOverlay" Property="Opacity" Value="0" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="RegisterButton"
                                        Content="注 册"
                                        Height="36"
                                        Background="#F2F3F5"
                                        Foreground="#333333"
                                        FontSize="15"
                                        FontWeight="Bold"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="RegisterButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    CornerRadius="10"
                                                    Background="{TemplateBinding Background}"
                                                    BorderThickness="0">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#E1E3E6" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- 忘记密码（90 版本：账号+救援代码找回，无需原密码） -->
                                <StackPanel HorizontalAlignment="Right" Margin="0,2,2,0">
                                    <Button x:Name="ForgotPasswordButton"
                                            Content="忘记密码？"
                                            Foreground="#8FC7FF"
                                            FontSize="12"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="4,2"
                                            Cursor="Hand"
                                            ToolTip="使用救援代码找回密码"
                                            Click="ForgotPasswordButton_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" Padding="4,2">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter TargetName="Bd" Property="Background" Value="#1A8FC7FF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>

                                <!-- 状态区：服务器状态 + 登录模式 -->
                                <StackPanel Margin="2,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="服务器状态："
                                                   Foreground="#CCFFFFFF"
                                                   FontSize="13"
                                                   VerticalAlignment="Center" />
                                        <Image x:Name="OnlineStatusImage"
                                               Width="16"
                                               Height="16"
                                               Stretch="Uniform"
                                               Margin="4,0,0,0"
                                               VerticalAlignment="Center" />
                                        <TextBlock x:Name="OnlineStatusText"
                                                   Text="检测中…"
                                                   Foreground="#CCFFFFFF"
                                                   FontSize="13"
                                                   Margin="4,0,0,0" />
                                    </StackPanel>
                                    <!-- 2026-10-15：登录模式固定为远程模式（配置页/版本选择都已隐藏），整行不再展示 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                                        <TextBlock Text="登录模式："
                                                   Foreground="#CCFFFFFF"
                                                   FontSize="13"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="ModeStatusText"
                                                   Text="本地模式"
                                                   Foreground="#CCFFFFFF"
                                                   FontSize="13"
                                                   Margin="4,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 游戏配置页 -->
            <local:GameConfigControl x:Name="ConfigPage"
                                     Margin="0,68,0,0"
                                     Visibility="Collapsed" />
            <!-- 游戏助手页
                 ASSIST-OFF-EXTERNAL（2026-09-20）：外网版整页停用（功能当前有问题，待修）。
                 XAML 无法条件编译，所以外网版是在 ApplyExternalUiLock() 里折叠
                 NavAssistant + AssistantPage（见 LoginWindow.xaml.cs）；功能侧另有
                 App 启动连发、GameAssistantControl 初始化、启动游戏时注入 Helper DLL/启 DPS
                 三处闸门。恢复时 grep ASSIST-OFF-EXTERNAL。 -->
            <local:GameAssistantControl x:Name="AssistantPage"
                                        Margin="0,68,0,0"
                                        Visibility="Collapsed" />
            <!-- DLL管理页 -->
            <local:DllManageControl x:Name="DllPage"
                                    Margin="0,68,0,0"
                                    Visibility="Collapsed" />
            <!-- GM Tool Page -->
            <gm:GmPageControl x:Name="GmPage"
                                 Margin="0,68,0,0"
                                 Visibility="Collapsed" />
            <!-- S4 系列内嵌 GM（A12/A21，直连 SQLite） -->
            <gm:S4GmPageControl x:Name="S4GmPage"
                                Margin="0,68,0,0"
                                Visibility="Collapsed" />
            <!-- 设置页 -->
            <local:SettingsControl x:Name="SettingsPage"
                                   Margin="0,68,0,0"
                                   Visibility="Collapsed" />
            <!-- CDK 兑换页（90 外网版） -->
            <local:CdkRedeemControl x:Name="CdkPage"
                                    Margin="0,68,0,0"
                                    Visibility="Collapsed" />
        </Grid>

        <!-- 底部：背景轮换剩余时间进度条（5 秒线性读条，切换时重置） -->
        <Grid x:Name="BgProgressWrap"
              Grid.RowSpan="2"
              Height="4"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Stretch"
              Panel.ZIndex="5">
            <Rectangle x:Name="BgProgressBar"
                       Fill="#FF36373A"
                       HorizontalAlignment="Left"
                       Width="0" />
        </Grid>

        <!-- 右上侧 Toast 通知容器（多条依次排列，独立计时收回） -->
        <StackPanel x:Name="ToastContainer"
                    Grid.RowSpan="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,58,16,0"
                    Width="320"
                    Panel.ZIndex="20" />

        <!-- 版本切换加载层：切换版本期间显示转圈，遮罩拦截交互避免连点 -->
        <Grid x:Name="VersionLoadingOverlay"
              Grid.RowSpan="2"
              Panel.ZIndex="40"
              Visibility="Collapsed"
              Background="#88000000">
            <Border Background="#DD181820"
                    BorderBrush="#FF2A2B31"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="VersionLoadingIcon"
                           Width="48"
                           Height="48"
                           Source="pack://application:,,,/assets/global-loading.png"
                           RenderTransformOrigin="0.5,0.5"
                           VerticalAlignment="Center">
                        <Image.RenderTransform>
                            <RotateTransform x:Name="VersionLoadingRotate" Angle="0" />
                        </Image.RenderTransform>
                    </Image>
                    <TextBlock Text="正在切换版本..."
                               Foreground="White"
                               FontSize="16"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</adu:AduWindow>
